APP_NAME="Student Hosting"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PROJECT_FILESYSTEM_DISK=project_files
HOSTING_BASE_DOMAIN=sites.example.com
HOSTING_URL_SCHEME=https
DOCKER_BINARY=docker
TRAEFIK_CONTAINER_NAME=hosting-traefik
TRAEFIK_CERTIFICATE_RESOLVER=letsencrypt
HOSTING_STATIC_IMAGE=student-hosting/static:latest
HOSTING_PHP_IMAGE=student-hosting/php83:latest
DOCKER_COMMAND_TIMEOUT=600
DOCKER_LOG_LINES=200
TRAEFIK_ACCESS_LOG_PATH=
MONITORING_ACCESS_LOG_BATCH_LINES=10000
MONITORING_CPU_WARNING_PERCENT=90
MONITORING_MEMORY_WARNING_PERCENT=90
MONITORING_BANDWIDTH_WARNING_PERCENT=80
MONITORING_SNAPSHOT_RETENTION_DAYS=30
HOSTING_DATABASE_ADMIN_CONNECTION=hosting_database_admin
HOSTING_DATABASE_ADMIN_HOST=127.0.0.1
HOSTING_DATABASE_ADMIN_PORT=3307
HOSTING_DATABASE_ADMIN_DATABASE=mysql
HOSTING_DATABASE_ADMIN_USERNAME=root
HOSTING_DATABASE_ADMIN_PASSWORD=
HOSTING_DATABASE_ADMIN_TIMEOUT=10
HOSTING_DATABASE_HOST=hosting-database
HOSTING_DATABASE_PORT=3306
HOSTING_DATABASE_NETWORK=hosting_database
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
